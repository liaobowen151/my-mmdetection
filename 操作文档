    （3）执行命令行

    python demo/image_demo.py data/F/vis/2269.jpg \
        configs/mm_grounding_dino/grounding_dino_swin-t_pretrain_obj365_goldg_grit9m_v3det.py \
        --weights checkpoints/grounding_dino_swin-t_pretrain_obj365_goldg_grit9m_v3det_20231204_095047-b448804b.pth \
        --texts 'the orange' \
        --tokens-positive -1

